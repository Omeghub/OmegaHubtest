local Players = game:GetService("Players")
local LocalPlayer = Players.LocalPlayer

local ScriptURL = "https://raw.githubusercontent.com/Omeghub/OmegaHubtest/refs/heads/main/fltest"

local queue = queue_on_teleport or 
              (syn and syn.queue_on_teleport) or 
              (fluxus and fluxus.queue_on_teleport) or
              queueonteleport

local function AutoReInject()
    if not queue then
        warn("⚠ Re-Inject Unsupported on this executor.")
        return
    end

    LocalPlayer.OnTeleport:Connect(function()
        print("Teleport detected → Script queued for reload.")
        queue("repeat task.wait() until game:IsLoaded() wait(2) loadstring(game:HttpGet('"..ScriptURL.."'))()")
    end)
end

task.spawn(AutoReInject)
print("🔁 Auto Reinject Active → Script will auto-load after teleport.")
