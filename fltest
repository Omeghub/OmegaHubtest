-- =========================================================
-- SETTINGS
local AutoFarm = false
local AutoSpell = false

local AttackDelay = 1         -- Swing toutes les 1 sec après TP
local SpellDelay = 0.05
local HeightAboveMob = 7

local Character, HRP
local HeartbeatConnection

-- =========================================================
-- UTIL: GetModelRoot (pour TP même si pas de PrimaryPart)
local function GetModelRoot(model)
    if model.PrimaryPart then return model.PrimaryPart end
    -- Cherche un descendant contenant "root"
    for _, v in pairs(model:GetDescendants()) do
        if v:IsA("BasePart") and v.Name:lower():find("root") then
            return v
        end
    end
    -- Sinon prends juste le premier BasePart
    for _, v in pairs(model:GetDescendants()) do
        if v:IsA("BasePart") then
            return v
        end
    end
    return nil
end

-- =========================================================
-- CHARACTER SETUP
local function SetupCharacter(char)
    Character = char
    HRP = char:WaitForChild("HumanoidRootPart")

    if HeartbeatConnection then
        HeartbeatConnection:Disconnect()
    end

    HeartbeatConnection = RunService.Heartbeat:Connect(function()
        if not AutoFarm or not HRP then return end

        local enemies = workspace:FindFirstChild("Enemies")
        if not enemies then return end

        local closest, shortest = nil, math.huge

        for _, mob in pairs(enemies:GetChildren()) do
            if mob:IsA("Model") then
                local hum = mob:FindFirstChildOfClass("Humanoid")
                local root = GetModelRoot(mob)

                if hum and hum.Health > 0 and root then
                    local dist = (root.Position - HRP.Position).Magnitude
                    if dist < shortest then
                        shortest = dist
                        closest = root
                    end
                end
            end
        end

        -- TP sur le premier mob trouvé
        if closest then
            HRP.CFrame = closest.CFrame * CFrame.new(0, HeightAboveMob, 0)

            -- Lance le Swing après 1 seconde
            task.spawn(function()
                task.wait(1)
                ReplicatedStorage:WaitForChild("Swing"):FireServer()
            end)
        end
    end)
end

-- =========================================================
-- AUTO SPELL (Q / E) - SIMULATION CLAVIER
task.spawn(function()
    while true do
        task.wait(0.1)
        if not AutoFarm or not AutoSpell then continue end

        local cdQ = LocalPlayer:FindFirstChild("cooldownQ")
        if cdQ and cdQ.Value <= 0 then
            VirtualInputManager:SendKeyEvent(true, Enum.KeyCode.Q, false, game)
            task.wait(SpellDelay)
            VirtualInputManager:SendKeyEvent(false, Enum.KeyCode.Q, false, game)
        end

        local cdE = LocalPlayer:FindFirstChild("cooldownE")
        if cdE and cdE.Value <= 0 then
            VirtualInputManager:SendKeyEvent(true, Enum.KeyCode.E, false, game)
            task.wait(SpellDelay)
            VirtualInputManager:SendKeyEvent(false, Enum.KeyCode.E, false, game)
        end
    end
end)

