-- =========================================================
-- KEYAUTH + HWID LOCK
-- =========================================================
local License = _G.Key or ""  -- l'utilisateur doit mettre sa key ici
local HttpService = game:GetService("HttpService")
local StarterGui = game:GetService("StarterGui")

-- =================  CONFIG KEYAUTH  =================
local AppName   = "OverScyth"        -- Nom de ton app KeyAuth
local OwnerID   = "S23XTKpUTe"       -- OwnerID KeyAuth
local APPVersion = "1.0"

-- ========= Récupération HWID (important pour HWID LOCK) =========
local success, HWID = pcall(function()
    return game:GetService("RbxAnalyticsService"):GetClientId()
end)

if not success then
    HWID = "Unknown-HWID"
end

StarterGui:SetCore("SendNotification",{Title="KeyAuth",Text="Checking License...",Duration=5})

-- ================== INIT ==================
local initReq = game:HttpGet(
    "https://keyauth.win/api/1.1/?name="..AppName.."&ownerid="..OwnerID.."&type=init&ver="..APPVersion
)

if initReq == "KeyAuth_Invalid" then
    game.Players.LocalPlayer:Kick("❌ Application not found / invalid !")
    return
end

local initData = HttpService:JSONDecode(initReq)
if not initData.success then
    game.Players.LocalPlayer:Kick("❌ Init error: "..initData.message)
    return
end

local sessionid = initData.sessionid

-- ================== CHECK LICENSE + HWID ==================

local licenseReq = game:HttpGet(
    "https://keyauth.win/api/1.1/?name="..AppName.."&ownerid="..OwnerID.."&type=license"..
    "&key="..License.."&hwid="..HWID.."&sessionid="..sessionid.."&ver="..APPVersion
)

local licenseData = HttpService:JSONDecode(licenseReq)

if not licenseData.success then
    game.Players.LocalPlayer:Kick("❌ Key Unauthorized : "..licenseData.message)
    return
end

StarterGui:SetCore("SendNotification",{Title="✔ AUTH SUCCESS",Text="Welcome "..licenseData.info.username,Duration=5})
print("Connected ✔")
print("User:",licenseData.info.username)
print("HWID:",HWID)

-- Ici, ton script se lance SEULEMENT si la Key + HWID sont validés.
-- ========================================================


-- =========================================================
-- CHARGEMENT DE FLUENT ET INTERFACE
-- =========================================================
local Fluent = loadstring(game:HttpGet("https://github.com/dawid-scripts/Fluent/releases/latest/download/main.lua"))()
local SaveManager = loadstring(game:HttpGet("https://raw.githubusercontent.com/ImBrokz89/test/main/addons"))()
local InterfaceManager = loadstring(game:HttpGet("https://raw.githubusercontent.com/ImBrokz89/test/main/Maddons"))()

local Window = Fluent:CreateWindow({
   Title = "Test System Keys",
   TabWidth = 160,
   Size = UDim2.fromOffset(580, 460),
   Theme = "Dark",
   Acrylic = false,
   MinimizeKey = Enum.KeyCode.End 
})

local Tabs = {
    Main = Window:AddTab({ Title = "Auto Farm", Icon = "swords" }),
    Raid = Window:AddTab({ Title = "Raid", Icon = "sword" }),
    Players = Window:AddTab({Title = "Player", Icon = "layers" }),
    Misc = Window:AddTab({ Title = "Misc", Icon = "flame" }),
    Settings = Window:AddTab({ Title = "Settings", Icon = "settings" })
}

-- =========================================================
-- CONFIGURATION SYSTEM
-- =========================================================
SaveManager:SetLibrary(Fluent)
InterfaceManager:SetLibrary(Fluent)
SaveManager:IgnoreThemeSettings()
InterfaceManager:BuildInterfaceSection(Tabs.Settings)
SaveManager:BuildConfigSection(Tabs.Settings)
SaveManager:LoadAutoloadConfig()
Window:SelectTab(1)

print("🎉 Script chargé avec KeyAuth activé !")
