--========================--
--   KEYAUTH IP CHECK     --
--========================--

local KeyFile = "OmegaAuth.txt"
local License

-- Load saved key
if pcall(function() return readfile(KeyFile) end) then
    License = readfile(KeyFile)
    print("[KEY LOADED] -> "..License)
else
    License = _G.Key
end

-- No key
if not License or License == "" then
    game.Players.LocalPlayer:Kick("⚠ Please set _G.Key before executing.")
    return
end

-- Services
local HttpService = game:GetService("HttpService")
local StarterGui = game:GetService("StarterGui")
local Player = game.Players.LocalPlayer

-- App info
local AppName    = "OverScyth"
local OwnerID    = "S23XTKpUTe"
local AppVersion = "1.0"

-- Notify
StarterGui:SetCore("SendNotification", {
    Title = "KeyAuth",
    Text = "Initializing...",
    Duration = 4
})

--========================--
--        INIT            --
--========================--
local initReq = game:HttpGet(
    "https://keyauth.win/api/1.1/?" ..
    "name="..AppName ..
    "&ownerid="..OwnerID ..
    "&type=init" ..
    "&ver="..AppVersion
)

local initData = HttpService:JSONDecode(initReq)

if not initData.success then
    Player:Kick("❌ INIT ERROR: "..initData.message)
    return
end

local sessionid = initData.sessionid
print("[INIT OK] Session:", sessionid)

--========================--
--     LICENSE CHECK      --
--        IP ONLY          --
--========================--
local licenseReq = game:HttpGet(
    "https://keyauth.win/api/1.1/?" ..
    "name="..AppName ..
    "&ownerid="..OwnerID ..
    "&type=license" ..
    "&key="..License ..
    "&sessionid="..sessionid ..
    "&ver="..AppVersion
)

local licenseData = HttpService:JSONDecode(licenseReq)

if not licenseData.success then
    Player:Kick("❌ BAD KEY: "..licenseData.message)
    return
end

--========================--
--     AUTH SUCCESS       --
--========================--

-- Save key
pcall(function()
    writefile(KeyFile, License)
end)

-- Print IP to confirm IP LOCK
print("====== AUTH SUCCESS ======")
print("Username :", licenseData.info.username)
print("IP LOCKED :", licenseData.info.ip)
print("Created  :", licenseData.info.createdate)
print("Last Login :", licenseData.info.lastlogin)
print("==========================")

StarterGui:SetCore("SendNotification", {
    Title = "✔ AUTH SUCCESS",
    Text = "IP Locked: "..licenseData.info.ip,
    Duration = 6
})

