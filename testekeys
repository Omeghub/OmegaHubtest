-- =========================================================
-- KEYAUTH CHECK
-- =========================================================
local License = _G.Key or "" -- clé entrée par l'utilisateur
local HttpService = game:GetService("HttpService")
local StarterGui = game:GetService("StarterGui")
local AppName = "OverScyth"
local OwnerID = "S23XTKpUTe"
local APPVersion = "1.0"

StarterGui:SetCore("SendNotification", {
	Title = AppName,
	Text = "Initializing Authentication...",
	Duration = 5
})

-- Init
local initReq = game:HttpGet('https://keyauth.win/api/1.1/?name='..AppName..'&ownerid='..OwnerID..'&type=init&ver='..APPVersion)
if initReq == "KeyAuth_Invalid" then
	game.Players.LocalPlayer:Kick("Application not found!")
	return
end

local initData = HttpService:JSONDecode(initReq)
if not initData.success then
	game.Players.LocalPlayer:Kick("Init Error: "..initData.message)
	return
end

local sessionid = initData.sessionid

-- Vérifier la clé
local licenseReq = game:HttpGet('https://keyauth.win/api/1.1/?name='..AppName..'&ownerid='..OwnerID..'&type=license&key='..License..'&ver='..APPVersion..'&sessionid='..sessionid)
local licenseData = HttpService:JSONDecode(licenseReq)

if not licenseData.success then
	game.Players.LocalPlayer:Kick("Key Invalid: "..licenseData.message)
	return
end

StarterGui:SetCore("SendNotification", {
	Title = AppName,
	Text = "Successfully Authorized :)",
	Duration = 5
})

print("✔ Logged in as: "..licenseData.info.username)
-- =========================================================

-- =========================================================
-- CHARGEMENT DE FLUENT ET INTERFACE
-- =========================================================
local Fluent = loadstring(game:HttpGet("https://github.com/dawid-scripts/Fluent/releases/latest/download/main.lua"))()
local SaveManager = loadstring(game:HttpGet("https://raw.githubusercontent.com/ImBrokz89/test/main/addons"))()
local InterfaceManager = loadstring(game:HttpGet("https://raw.githubusercontent.com/ImBrokz89/test/main/Maddons"))()

local Window = Fluent:CreateWindow({
   Title = "Test System Keys",
   TabWidth = 160,
   Size = UDim2.fromOffset(580, 460),
   Theme = "Dark",
   Acrylic = false,
   MinimizeKey = Enum.KeyCode.End 
})

local Tabs = {
    Main = Window:AddTab({ Title = "Auto Farm", Icon = "swords" }),
    Raid = Window:AddTab({ Title = "Raid", Icon = "sword" }),
    Players = Window:AddTab({Title = "Player", Icon = "layers" }),
    Misc = Window:AddTab({ Title = "Misc", Icon = "flame" }),
    Settings = Window:AddTab({ Title = "Settings", Icon = "settings" })
}

-- =========================================================
-- CONFIGURATION SYSTEM
-- =========================================================
SaveManager:SetLibrary(Fluent)
InterfaceManager:SetLibrary(Fluent)
SaveManager:IgnoreThemeSettings()
InterfaceManager:BuildInterfaceSection(Tabs.Settings)
SaveManager:BuildConfigSection(Tabs.Settings)
SaveManager:LoadAutoloadConfig()
Window:SelectTab(1)

print("🎉 Script chargé avec KeyAuth activé !")
