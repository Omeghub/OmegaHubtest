--=============================--
--  🔐 OmegaHub - KeyAuth Loader
--=============================--

if getgenv().Omega_LoaderRan then
    return warn("⛔ Loader déjà exécuté.")
end
getgenv().Omega_LoaderRan = true

--=============================--
-- 📁 Gestion Key & Fichier
--=============================--
local KeyFile = "OmegaAuthKey.txt"
local License = nil

-- Lecteur de clé locale sinon prend _G.Key
if pcall(function() return readfile(KeyFile) end) then
    License = readfile(KeyFile)
    print("[KEY LOADED] → "..License)
else
    License = _G.Key or nil
end

if not License or License == "" then
    game.Players.LocalPlayer:Kick("⚠ Entrez votre clé via _G.Key avant d'exécuter.")
    return
end

--=============================--
-- 🔑 KeyAuth Informations
--=============================--
local HttpService = game:GetService("HttpService")
local StarterGui = game:GetService("StarterGui")

local AppName     = "OverScyth"          -- NOM dans KeyAuth
local OwnerID     = "S23XTKpUTe"         -- OWNER ID KeyAuth
local APPVersion  = "1.0"                -- version API

--=============================--
-- 🖥 HWID LOCK
--=============================--
local HWID = "UNKNOWN"
pcall(function()
    HWID = game:GetService("RbxAnalyticsService"):GetClientId()
end)

--=============================--
StarterGui:SetCore("SendNotification",{Title="KeyAuth",Text="Vérification de licence...",Duration=4})

--=============================--
-- 🔥 INIT SESSION
--=============================--
local initReq = game:HttpGet("https://keyauth.win/api/1.1/?name="..AppName.."&ownerid="..OwnerID.."&type=init&ver="..APPVersion)
local init = HttpService:JSONDecode(initReq)

if not init.success then
    game.Players.LocalPlayer:Kick("❌ INIT ERROR ➜ "..init.message)
    return
end

local session = init.sessionid

--=============================--
-- 🔥 Vérification licence (+ HWID LOCK)
--=============================--
local authReq = game:HttpGet(
    "https://keyauth.win/api/1.1/?name="..AppName..
    "&ownerid="..OwnerID.."&type=license"..
    "&key="..License.."&hwid="..HWID..
    "&sessionid="..session.."&ver="..APPVersion
)

local auth = HttpService:JSONDecode(authReq)

if not auth.success then
    game.Players.LocalPlayer:Kick("🚫 LICENCE ERROR ➜ "..auth.message)
    return
end

--=============================--
-- 💾 Sauvegarde KEY AUTO
--=============================--
pcall(function()
    writefile(KeyFile, License)
    print("[KEY SAVED] ✔")
end)

StarterGui:SetCore("SendNotification",{Title="✔ Auth OK",Text="Bienvenue "..auth.info.username,Duration=4})
print("🎉 AUTHENTIFICATION RÉUSSIE\n")

--=============================--
-- 🔽 CHARGEMENT INTERFACE
--=============================--
local Fluent = loadstring(game:HttpGet("https://github.com/dawid-scripts/Fluent/releases/latest/download/main.lua"))()
local SaveManager = loadstring(game:HttpGet("https://raw.githubusercontent.com/ImBrokz89/test/main/addons"))()
local InterfaceManager = loadstring(game:HttpGet("https://raw.githubusercontent.com/ImBrokz89/test/main/Maddons"))()

local Window = Fluent:CreateWindow({
   Title = "OmegaHub | Key System",
   TabWidth = 160,
   Size = UDim2.fromOffset(580, 460),
   Theme = "Dark",
   Acrylic = false,
   MinimizeKey = Enum.KeyCode.End 
})

local Tabs = {
    Main     = Window:AddTab({ Title = "Auto Farm", Icon = "swords" }),
    Raid     = Window:AddTab({ Title = "Raid", Icon = "sword" }),
    Players  = Window:AddTab({ Title = "Player", Icon = "layers" }),
    Misc     = Window:AddTab({ Title = "Misc", Icon = "flame" }),
    Settings = Window:AddTab({ Title = "Settings", Icon = "settings" })
}

SaveManager:SetLibrary(Fluent)
InterfaceManager:SetLibrary(Fluent)
SaveManager:IgnoreThemeSettings()
InterfaceManager:BuildInterfaceSection(Tabs.Settings)
SaveManager:BuildConfigSection(Tabs.Settings)
SaveManager:LoadAutoloadConfig()
Window:SelectTab(1)

print("🟢 Interface chargée avec succès !")
