-- KEYAUTH SYSTEM
--=====================================================

local name = "OverScyth"        -- Nom de ton App
local ownerid = "S23XTKpUTe"    -- OwnerID
local secret = "a7a2a5ecfa65be6080ffbd7d7bf9150c1219c9ba9fd055908ba90c9942315331"     -- trouve-le dans KeyAuth "App Credentials"
local version = "1.0"

local key = _G.Key -- clé entrée par l'utilisateur

local HttpService = game:GetService("HttpService")

local function request(url)
    local res = game:HttpGet(url)
    return HttpService:JSONDecode(res)
end

-- 🔹 Init obligatoire avant login
local initURL = string.format(
    "https://keyauth.win/api/1.2/?type=init&name=%s&ownerid=%s&ver=%s",
    name, ownerid, version
)

local init = request(initURL)
if not init.success then
    game.Players.LocalPlayer:Kick("❌ KeyAuth Init Error : " .. init.message)
    return
end

-- 🔹 Vérification de clé
local loginURL = string.format(
    "https://keyauth.win/api/1.2/?type=login&name=%s&ownerid=%s&key=%s",
    name, ownerid, key
)

local auth = request(loginURL)

if not auth.success then
    game.Players.LocalPlayer:Kick("❌ Invalid Key : " .. auth.message)
    return
end

print("✔ Key Valid - Script Loading...")

-- =========================================================
-- CHARGEMENT DE FLUENT ET INTERFACE
-- =========================================================
